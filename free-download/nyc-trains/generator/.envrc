# Local MySQL connection info for nyc-trains — used by docker-compose.yml
# (variable substitution reads these from the shell environment, not from
# this file directly) and by any `mysql` client command you run against
# the container by hand.
#
# direnv (https://direnv.net) loads this automatically on `cd` into this
# directory once you run `direnv allow` here; without direnv, `source
# .envrc` does the same for the current shell. Either way, load it
# *before* `docker compose up`.
#
# These are throwaway local-dev passwords for a container that only ever
# binds to 127.0.0.1 — not real secrets, fine to keep checked in. Change
# them if you expose the port more broadly.

export MYSQL_HOST=127.0.0.1
export MYSQL_PORT=3306
export MYSQL_DATABASE=nyc_trains
export MYSQL_USER=nyc_trains
export MYSQL_PASSWORD=nyc_trains_dev_pw
export MYSQL_ROOT_PASSWORD=nyc_trains_root_dev_pw
